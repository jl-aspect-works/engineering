+name: Repository checks
+
+on:
+  pull_request:
+    branches: [main]
+  push:
+    branches: [main]
+
+permissions:
+  contents: read
+
+jobs:
+  checks:
+    name: Required repository checks
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+      - name: Verify checker failure paths
+        run: python3 .github/scripts/test_repository_checks.py
+      - name: Check assets, documentation, and Action pins
+        run: python3 .github/scripts/check-repository.py
